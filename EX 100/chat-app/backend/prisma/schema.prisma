datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id        Int      @id @default(autoincrement())
  role      String
  content   String
  createdAt DateTime @default(now())
  username  String?  @default("Anonyme") // Pour savoir qui a écrit
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
}
